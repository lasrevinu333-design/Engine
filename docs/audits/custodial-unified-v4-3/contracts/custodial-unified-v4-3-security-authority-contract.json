  "credential_types": [
    {
      "id": "public-none",
      "principal": "public-read",
      "accepted_only_on_plane": "public-read",
      "wrong_presented_credential_behavior": "terminal deny; never downgrade"
    },
    {
      "id": "human-session-token",
      "principal_pattern": "human-*",
      "expiry_required": true,
      "revocation_required": true
    },
    {
      "id": "device-bound-key",
      "principal": "device-installation",
      "hardware_or_os_bound": true,
      "rotation_required": true
    },
    {
      "id": "service-token",
      "principal_pattern": "svc-*",
      "resource_scope_required": true,
      "rotation_required": true,
      "revocation_required": true
    }
  ],
  "session_types": [
    {
      "id": "public-read-session",
      "credential": "public-none",
      "tool_surface": "PUBLIC_READ_TOOLS",
      "writes": false
    },
    {
      "id": "human-session",
      "credential": "human-session-token",
      "capability_intersection": true
    },
    {
      "id": "device-session",
      "credential": "device-bound-key",
      "epoch_bound": true
    },
    {
      "id": "service-session",
      "credential": "service-token",
      "service_principal_exact": true
    }
  ],
  "grant_schema": {
    "required": [
      "grant_id",
      "principal_id",
      "capability",
      "resource",
      "authority_set_id",
      "valid_from",
      "valid_until",
      "issuer_principal_id",
      "sequence"
    ],
    "revocation": "append-only, immediate cache invalidation"
  },
  "authorization_decision_schema": {
    "required": [
      "decision_id",
      "request_id",
      "principal_id",
      "credential_id",
      "session_id",
      "grant_id",
      "capability",
      "resource",
      "authority_set_id",
      "policy_version",
      "decision",
      "reason_code",
      "decided_at",
      "idempotency_key"
    ],
    "decisions": [
      "ALLOW",
      "DENY",
      "QUARANTINE"
    ],
    "one_receipt_per_privileged_action": true
  },
  "executable_tool_schema": {
    "required": [
      "tool_id",
      "plane_id",
      "endpoint",
      "capability",
      "resource_allowlist",
      "request_limit",
      "response_limit",
      "side_effect_class",
      "service_principal_id"
    ],
    "aliases_must_be_registered": true
  },
  "planes": [
    {
      "id": "public-read",
      "endpoint_class": "fixed separate endpoint",
      "accepted_credential": "public-none",
      "principal": "public-read",
      "tool_allowlist": [
        "bounded diagnostics",
        "registered GitHub read",
        "registered bounded SQL read"
      ],
      "forbidden": [
        "writer",
        "migration",
        "arbitrary SQL",
        "repair",
        "admin",
        "privileged alias"
      ],
      "wrong_token": "DENY",
      "default": "read-only"
    },
    {
      "id": "privileged-automation",
      "endpoint_class": "authenticated endpoint",
      "accepted_credential": "service-token",
      "principal": "exact named service principal",
      "tool_allowlist": "registry intersection only",
      "resource_allowlist": "grant intersection only",
      "wrong_token": "DENY",
      "default": "no tools"
    },
    {
      "id": "migration",
      "endpoint_class": "separate administrative plane",
      "accepted_credential": "service-token",
      "principal": "svc-migration",
      "tool_allowlist": [
        "registered migration only"
      ],
      "wrong_token": "DENY",
      "default": "no tools"
    }
  ],
  "transition_model": {
    "compatibility": "bounded, observable, reversible, non-authoritative, expiry dated",
    "public_continuity": "preserve registered reads",
    "rollback": "revert routing without broadening surfaces",
    "retirement_gate": "G-TOOL-REGISTRY"
  },
  "negative_tests": [
    "NO_TOKEN_PUBLIC_WRITES_ABSENT",
    "WRONG_TOKEN_NO_DOWNGRADE",
    "EXPIRED_DENY",
    "REVOKED_DENY",
    "WRONG_RESOURCE_DENY",
    "WRONG_AUTHORITY_SET_DENY",
    "REPLAY_IDEMPOTENT",
    "CONFUSED_DEPUTY_DENY",
    "APP_RUNTIME_NO_MIGRATION",
    "PUBLIC_ALIASES_NO_PRIVILEGE"
  ]
}
