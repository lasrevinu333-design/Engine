      },
      {
        "name": "projection_compatibility",
        "json_type": "string",
        "presence": "registry_inherited",
        "condition": null,
        "semantics": "Registered projection compatibility and rebuild behavior.",
        "immutable": true
      },
      {
        "name": "unknown_version_behavior",
        "json_type": "string",
        "presence": "registry_inherited",
        "condition": null,
        "semantics": "Must reject_or_quarantine; coercion or best-effort parsing is forbidden.",
        "immutable": true
      }
    ],
    "conditions": [
      {
        "id": "COND-AGGREGATE-SEQUENCE",
        "when": "ordering_rule == aggregate_sequence",
        "requires": [
          "aggregate_sequence"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORDERING_CONTEXT_MISSING"
      },
      {
        "id": "COND-VALID-INTERVAL",
        "when": "valid_time_kind == interval",
        "requires": [
          "valid_time_end"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_VALID_TIME_INCOMPLETE"
      },
      {
        "id": "COND-SERVICE-TIME",
        "when": "record_type declares service-time semantics",
        "requires": [
          "service_date",
          "service_day_offset_minutes",
          "service_time_zone"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_SERVICE_TIME_INCOMPLETE"
      },
      {
        "id": "COND-DST-AMBIGUOUS",
        "when": "America/Chicago local wall time is ambiguous",
        "requires": [
          "service_time_fold"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_DST_FOLD_MISSING"
      },
      {
        "id": "COND-AUTHORIZATION",
        "when": "record is a privileged command, authorization decision, delayed submission, or offline operation",
        "requires": [
          "authorization_decision_id",
          "authorization_snapshot_digest"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORIGINAL_AUTHORIZATION_MISSING"
      },
      {
        "id": "COND-CREDENTIAL-CONTEXT",
        "when": "operation originated from a credentialed principal or is delayed/offline",
        "requires": [
          "credential_id"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORIGINAL_CREDENTIAL_MISSING"
      },
      {
        "id": "COND-SESSION-CONTEXT",
        "when": "operation originated in a session or is delayed/offline session work",
        "requires": [
          "session_id"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORIGINAL_SESSION_MISSING"
      },
      {
        "id": "COND-DEVICE-CONTEXT",
        "when": "operation is device-bound or delayed/offline device work",
        "requires": [
          "device_id"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORIGINAL_DEVICE_MISSING"
      },
      {
        "id": "COND-ASSIGNMENT-EPOCH",
        "when": "operation is employee-device work or delayed/offline employee-device work",
        "requires": [
          "assignment_epoch_id"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_ORIGINAL_ASSIGNMENT_EPOCH_MISSING"
      },
      {
        "id": "COND-SOURCE-EVIDENCE",
        "when": "record is imported, reconstructed, migrated, or derived from an external artifact",
        "requires": [
          "source_artifact_id",
          "source_revision",
          "source_confidence"
        ],
        "forbids": [],
        "failure": "RECORD_ENVELOPE_SOURCE_CONTEXT_MISSING"
      }
    ],
    "actor_and_authorization_binding": {
      "original_actor_controls": true,
      "original_authorization_controls": true,
      "current_server_state_substitution": "forbidden",
      "offline_acceptance_outcomes": [
        "accept_original_contract",
        "duplicate",
        "terminal_reject",
        "conflict_quarantine"
      ],
      "cross_employee_reattribution": "forbidden"
    },
    "ordering": {
      "ordering_rule_required": true,
      "aggregate_sequence_requires_expected_previous": true,
      "sequence_gap_behavior": "reject_or_quarantine",
      "duplicate_sequence_behavior": "idempotent_only_when_record_id_and_digest_match"
    },
    "valid_time": {
      "kinds": [
        "instant",
        "interval"
      ],
      "interval_end_semantics": "exclusive",
      "open_ended_interval": "allowed_only_when_record_type_registry_explicitly_allows",
      "recorded_before_occurred": "allowed_only_with_registered_clock_or_import_reason",
      "failure_behavior": "reject_or_quarantine"
    },
    "lineage": {
      "relations": [
        "supersedes",
        "corrects",
        "voids",
        "derives_from"
      ],
      "arrays_are_required": true,
      "empty_array_means_none": true,
      "missing_is_invalid": true,
      "cycles": "reject"
    },
    "transaction_rule": "The authoritative record, original authorization decision/snapshot, declared index or projection checkpoint, and outbox intents commit atomically or none is authoritative.",
    "failure_outcome": "DENY_OR_QUARANTINE_WITH_STABLE_CODE_NO_LOCAL_FALLBACK"
  },
  "canonical_json": {
    "contract_id": "canonical-json.v1",
    "encoding": "UTF-8",
    "unicode_normalization": "NFC",
    "object_key_order": "ascending Unicode scalar value sequence after NFC",
    "duplicate_object_keys": "reject_before_JSON_parse",
    "nfc_key_collision": "reject",
    "array_order": {
      "default": "reject_unregistered_array_path",
      "policies": [
        {
          "path_pattern": "/supersedes_record_ids",
          "mode": "set_sorted_by_canonical_utf8_bytes"
        },
        {
          "path_pattern": "/corrects_record_ids",
          "mode": "set_sorted_by_canonical_utf8_bytes"
        },
        {
          "path_pattern": "/voids_record_ids",
          "mode": "set_sorted_by_canonical_utf8_bytes"
        },
        {
          "path_pattern": "/derives_from_record_ids",
          "mode": "set_sorted_by_canonical_utf8_bytes"
        },
        {
          "path_pattern": "/domain_payload/*",
          "mode": "record_type_registry_declares_order"
        }
      ]
    },
    "timestamps": {
      "wire_format": "YYYY-MM-DDTHH:mm:ss.SSSZ",
      "timezone": "UTC",
      "offsets": "forbidden",
      "precision": "exactly_3_fractional_digits",
      "leap_seconds": "reject"
    },
    "service_time": {
      "time_zone": "America/Chicago",
      "service_date_format": "YYYY-MM-DD",
      "day_offset_unit": "integer_minutes",
      "spring_forward_nonexistent_local_time": "reject",
      "fall_back_ambiguous_local_time": "require_service_time_fold_0_or_1",
      "server_locale_inference": "forbidden"
    },
    "decimals": {
      "representation": "JSON string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "exponent": "forbidden",
      "leading_plus": "forbidden",
      "leading_zero": "forbidden_except_zero",
      "negative_zero": "forbidden",
      "trailing_fraction_zero": "forbidden"
    },
    "null_missing_empty": {
      "missing": "field not present; only allowed when schema condition is false",
      "null": "explicit unknown or not-applicable only when exact schema permits",
      "empty_string": "known present zero-length text",
      "empty_array": "known present collection with zero members",
      "empty_object": "known present object with zero properties only when exact schema permits",
      "equivalence": "never"
    },
    "forbidden_values": [
      "NaN",
      "Infinity",
      "-Infinity",
      "undefined",
      "functions",
      "symbols",
      "bigint_without_registered_decimal_encoding"
    ],
    "hashes": {
      "algorithm": "sha-256",
      "algorithm_id_field": "hash_algorithm",
      "canonicalization_id_field": "canonicalization_version",
      "source_bytes_digest": "SHA-256 of exact raw domain-payload or source-artifact bytes before normalization; never the containing envelope",
      "normalized_content_digest": "SHA-256 of the canonical record with source_bytes_digest, normalized_content_digest, and payload_digest omitted",
      "payload_digest": "SHA-256 of canonical domain_payload only",
      "self_reference": "forbidden",
      "digest_mismatch": "reject_or_quarantine"
    },
    "canonicalization_steps": [
      "validate raw UTF-8 and reject BOM unless source contract explicitly admits and strips it before hashing",
      "detect duplicate object keys before parsing",
      "parse JSON without non-finite extensions",
      "normalize every key and string value to Unicode NFC",
      "reject normalization-created duplicate keys",
      "apply the registered array policy at every array path",
      "validate timestamp, service-time, decimal, null/missing/empty, and record-envelope semantics",
      "sort object keys by Unicode scalar value sequence",
      "serialize with no insignificant whitespace",
      "encode UTF-8",
      "compute and verify source, normalized-content, and payload SHA-256 digests"
    ]
  },
  "per_record_strengthening": {
    "rule": "Every record type/version inherits canonical-record-envelope.v1 and may only add fields or strengthen constraints.",
    "prohibited": [
      "remove an envelope field",
      "widen an envelope type or enum",
      "weaken a presence condition",
      "replace original actor or authorization with current server state",
      "change canonical-json.v1",
      "accept unknown versions by coercion",
      "collapse null, missing, or empty"
    ],
    "profiles": [
      {
        "record_type": "source_tuple",
        "base_contract": "canonical-record-envelope.v1",
        "may_add_fields": true,
        "may_strengthen_constraints": true,
