{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodial.invalid/schemas/manager-session.event.v1.schema.json",
  "title": "manager-session.event.v1",
  "description": "Policy-gated candidate schema; validation-only and not runtime-admitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_snapshot_digest",
    "aggregate_id",
    "aggregate_sequence",
    "aggregate_type",
    "authority_set_generation",
    "authority_set_id",
    "authorization_decision_id",
    "authorization_snapshot_digest",
    "canonicalization_version",
    "causation_id",
    "corrects_record_ids",
    "correlation_id",
    "credential_id",
    "derives_from_record_ids",
    "device_id",
    "domain_payload",
    "hash_algorithm",
    "idempotency_key",
    "normalized_content_digest",
    "occurred_at",
    "operation_id",
    "ordering_rule",
    "payload_digest",
    "principal_id",
    "producer_release_id",
    "projection_compatibility",
    "record_class",
    "record_id",
    "record_registry_revision",
    "record_type",
    "recorded_at",
    "replay_compatibility",
    "retention_class",
    "schema_version",
    "sensitivity_class",
    "session_id",
    "source_bytes_digest",
    "source_contract_revision",
    "source_domain",
    "supersedes_record_ids",
    "unknown_version_behavior",
    "valid_time_kind",
    "valid_time_start",
    "voids_record_ids"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Globally unique immutable record identifier."
    },
    "record_class": {
      "const": "event"
    },
    "record_type": {
      "const": "manager-session.event.v1"
    },
    "schema_version": {
      "const": "v1"
    },
    "record_registry_revision": {
      "const": "authority-schema-component.v1"
    },
    "authority_set_id": {
      "type": "string",
      "minLength": 1,
      "description": "Exact distributed authority-set identity."
    },
    "authority_set_generation": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic generation admitted by the authority-set protocol."
    },
    "source_domain": {
      "const": "SECURITY_AUTHORITY"
    },
    "source_contract_revision": {
      "const": "authority-schema-component.v1"
    },
    "aggregate_type": {
      "const": "manager-session"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate/entity identity."
    },
    "ordering_rule": {
      "const": "aggregate_sequence"
    },
    "aggregate_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic expected sequence when ordering_rule is aggregate_sequence."
    },
    "valid_time_kind": {
      "const": "instant"
    },
    "valid_time_start": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant at which the fact/command is valid or interval begins."
    },
    "valid_time_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "UTC exclusive interval end; null is allowed only for explicitly open-ended registered record types."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC fixed-precision timestamp when authority durably recorded the record."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC fixed-precision occurrence or issue time."
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "America/Chicago service date from the registered time authority."
    },
    "service_day_offset_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "Minutes from the service-day boundary; not inferred from server locale."
    },
    "service_time_zone": {
      "type": "string",
      "minLength": 1,
      "description": "Must be America/Chicago for current Custodial service-time semantics."
    },
    "service_time_fold": {
      "type": "integer",
      "minimum": 0,
      "description": "0 or 1 when a local service time is ambiguous during fall-back."
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable operation identity."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Stable idempotency identity scoped by record type and aggregate."
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit correlation identity; null means no correlation and is not equivalent to missing."
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit causal predecessor; null means none and is not equivalent to missing."
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical original human or service principal."
    },
    "actor_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of the immutable original actor snapshot."
    },
    "authorization_decision_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original authorization-decision identity for privileged or delayed/offline work."
    },
    "authorization_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of the immutable original authorization evidence."
    },
    "credential_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original credential identity; current credential must never be substituted."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original session identity."
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original stable device identity."
    },
    "assignment_epoch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original device-assignment epoch; current assignee must never be substituted."
    },
    "source_artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Source artifact identity for imported/derived evidence."
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "description": "Exact source revision."
    },
    "source_confidence": {
      "type": "string",
      "minLength": 1,
      "description": "Registered confidence classification."
    },
    "supersedes_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true,
      "description": "Canonical set of records superseded by this record; empty array means none."
    },
    "corrects_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true,
      "description": "Canonical set of records corrected; empty array means none."
    },
    "voids_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true,
      "description": "Canonical set of records voided; empty array means none."
    },
    "derives_from_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "uniqueItems": true,
      "description": "Canonical set of source records; empty array means none."
    },
    "sensitivity_class": {
      "const": "RESTRICTED_SESSION"
    },
    "retention_class": {
      "const": "SESSION_SECURITY_2Y"
    },
    "domain_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "grant_id",
        "tool_id"
      ],
      "properties": {
        "assignment_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "authority_set_generation": {
          "type": "integer",
          "minimum": 0
        },
        "authority_set_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "authorization_decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "canonical_payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "command_id": {
          "enum": [
            "CMD-MGRSESSION-CLOSE",
            "CMD-MGRSESSION-EXPIRE",
            "CMD-MGRSESSION-OPEN",
            "CMD-MGRSESSION-REFRESH",
            "CMD-MGRSESSION-REQUIRE-REFRESH",
            "CMD-MGRSESSION-REVOKE"
          ]
        },
        "compatibility_matrix_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "credential_class": {
          "enum": [
            "EMPLOYEE_DEVICE",
            "MANAGER_DEVICE",
            "RELEASE_SERVICE",
            "SECURITY_ADMIN"
          ]
        },
        "credential_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "dependency_graph_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_aggregate_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "fence_token": {
          "type": "integer",
          "minimum": 0
        },
        "grant_id": {
          "enum": [
            "GRANT-MANAGER"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "manager_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "principal_class": {
          "enum": [
            "EMPLOYEE",
            "MANAGER",
            "RELEASE_SERVICE",
            "SECURITY_ADMIN"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "producer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "release_tuple_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "resource_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "rollback_tuple_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "trusted_device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "tool_id": {
          "enum": [
            "TOOL-MANAGER"
          ]
        },
        "command_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "event_type": {
          "enum": [
            "EVT-MGRSESSION-CLOSE",
            "EVT-MGRSESSION-EXPIRE",
            "EVT-MGRSESSION-OPEN",
            "EVT-MGRSESSION-REFRESH",
            "EVT-MGRSESSION-REQUIRE-REFRESH",
            "EVT-MGRSESSION-REVOKE"
          ]
        },
        "prior_state": {
          "enum": [
            "ACTIVE",
            "CLOSED",
            "REFRESH_REQUIRED"
          ]
        },
        "state": {
          "enum": [
            "ACTIVE",
            "CLOSED",
            "EXPIRED",
            "REFRESH_REQUIRED",
            "REVOKED"
          ]
        },
        "outcome": {
          "const": "COMMITTED"
        }
      }
    },
    "source_bytes_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of exact raw domain-payload or source-artifact bytes before normalization; never the whole envelope containing the digest."
    },
    "normalized_content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical record after omitting source_bytes_digest, normalized_content_digest, and payload_digest fields."
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonicalized domain payload only."
    },
    "hash_algorithm": {
      "const": "sha-256"
    },
    "canonicalization_version": {
      "const": "canonical-json.v1"
    },
    "producer_release_id": {
      "type": "string",
      "minLength": 1,
      "description": "Exact producer implementation/release identity."
    },
    "replay_compatibility": {
      "const": "v1-only-idempotent-replay"
    },
    "projection_compatibility": {
      "const": "rebuild-from-events-v1"
    },
    "unknown_version_behavior": {
      "const": "reject_or_quarantine"
    }
  },
