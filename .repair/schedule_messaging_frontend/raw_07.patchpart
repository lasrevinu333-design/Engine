,{sender_user_id:state.currentUserId,body,device_id:state.currentDeviceId}); } playChatSwoosh('send'); await loadThreadMeta(); await refreshMessages(); setStatus('Sent.'); }catch(error){ els.composeInput.value=draft; setStatus(`Send failed: ${safe(error)}`, { sticky:true }); console.error('send message failed:', error); }finally{ renderComposerState(); els.sendBtn.textContent=oldButtonText; } }
+async function sendMessage(){ const body=String(els.composeInput.value||'').trim(); if(!body||!state.threadId||state.thread?.viewer_can_send===false)return; const draft=body; const clientMessageId=state.pendingClientBody===body&&state.pendingClientMessageId?state.pendingClientMessageId:createClientMessageId(); state.pendingClientMessageId=clientMessageId; state.pendingClientBody=body; const oldButtonText=els.sendBtn.textContent||'Send'; els.composeInput.value=''; els.sendBtn.disabled=true; els.sendBtn.textContent='Sending…'; setStatus('Sending message…', { sticky:true }); try{ if(isMemphisConversation(state.thread)){ await apiPost('/memphis/message',{user_id:state.currentUserId,body,device_id:state.currentDeviceId,client_message_id:clientMessageId}); }else{ await apiPost(`/thread/${encodeURIComponent(state.threadId)}/message`,{sender_user_id:state.currentUserId,body,device_id:state.currentDeviceId,client_message_id:clientMessageId}); } state.pendingClientMessageId=''; state.pendingClientBody=''; playChatSwoosh('send'); await loadThreadMeta(); await refreshMessages(); setStatus('Sent.'); }catch(error){ els.composeInput.value=draft; setStatus(`Send failed: ${safe(error)}`, { sticky:true }); console.error('send message failed:', error); }finally{ renderComposerState(); els.sendBtn.textContent=oldButtonText; } }
 function normalizeThread(thread){ return {...thread,id:thread.id||thread.thread_id||'',thread_title:thread.thread_title||thread.title||'',thread_type:thread.thread_type||'direct',viewer_can_send:thread.viewer_can_send!==false,participant_names:thread.participant_names||''}; }
 function labelThreadType(value){ const v=String(value||'').toLowerCase(); if(v==='bot')return 'Memphis'; if(v==='group')return 'Group chat'; if(v==='broadcast')return 'Broadcast'; return 'Direct chat'; }
 function formatLongTime(value){ if(!value)return ''; const d=new Date(value); return Number.isNaN(d.getTime())?'':d.toLocaleString([],{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}); }
