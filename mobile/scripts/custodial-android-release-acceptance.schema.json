        "legacy_resource": {
          "allOf": [
            {
              "$ref": "#/$defs/compiledBackupResource"
            },
            {
              "type": "object",
              "properties": {
                "logical_name": {
                  "const": "xml/memphis_zoo_backup_rules"
                }
              }
            }
          ]
        },
        "data_extraction_resource": {
          "allOf": [
            {
              "$ref": "#/$defs/compiledBackupResource"
            },
            {
              "type": "object",
              "properties": {
                "logical_name": {
                  "const": "xml/memphis_zoo_data_extraction_rules"
                }
              }
            }
          ]
        }
      }
