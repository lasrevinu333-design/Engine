{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memphis-zoo:custodial-android-release-acceptance:v5",
  "title": "Memphis Zoo Custodial Android release acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "accepted",
    "generated_at",
    "artifact",
    "application",
    "embedded_provenance",
    "source",
    "build",
    "signing",
    "alignment",
    "backup",
    "android_manifest_security",
    "native_security",
    "tools",
    "verifier"
  ],
  "properties": {
