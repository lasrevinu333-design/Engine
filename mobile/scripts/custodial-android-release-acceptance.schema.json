        "verifier_version": {
          "const": "2.0.1"
        },
        "policy": {
          "const": "deny-cloud-backup-and-device-transfer"
        },
        "allow_backup": {
          "const": false
        },
        "excluded_domains": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "root"
            },
            {
              "const": "file"
            },
            {
              "const": "database"
            },
            {
              "const": "sharedpref"
            },
            {
              "const": "external"
            },
            {
              "const": "device_root"
            },
            {
              "const": "device_file"
            },
            {
              "const": "device_database"
            },
            {
              "const": "device_sharedpref"
            }
