{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memphis-zoo:custodial-android-release-acceptance:v3",
  "title": "Memphis Zoo Custodial Android release acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "accepted",
    "generated_at",
    "artifact",
    "application",
    "embedded_provenance",
    "source",
    "build",
    "signing",
    "alignment",
    "backup",
    "native_security",
    "tools",
    "verifier"
  ],
  "properties": {
    "schema_id": { "const": "urn:memphis-zoo:custodial-android-release-acceptance:v3" },
    "schema_version": { "const": 3 },
    "accepted": { "const": true },
    "generated_at": { "type": "string", "format": "date-time" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "apk_sha256", "size_bytes"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "apk_sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_code",
        "version_name",
        "min_sdk_version",
        "target_sdk_version",
        "debuggable",
        "test_only"
      ],
      "properties": {
        "package_name": { "const": "org.memphiszoo.custodial" },
        "version_code": { "type": "integer", "minimum": 11 },
        "version_name": { "const": "1.0.0" },
        "min_sdk_version": { "const": 26 },
        "target_sdk_version": { "const": 36 },
        "debuggable": { "const": false },
        "test_only": { "const": false }
      }
    },
    "embedded_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "source_commit",
        "source_tree",
        "source_commit_exact",
        "custodial_native_vault_source_sha256",
        "release_id",
        "build_id",
        "native_build_number",
        "runtime_asset_count",
        "runtime_assets_verified",
        "capacitor_generated_assets_sha256",
        "build_json_sha256",
        "runtime_asset_manifest_sha256",
        "build_identity_js_sha256"
      ],
      "properties": {
        "edition": { "const": "custodial" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "source_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "source_commit_exact": { "const": true },
        "custodial_native_vault_source_sha256": { "$ref": "#/$defs/sha256" },
        "release_id": { "type": "string", "minLength": 1 },
        "build_id": { "type": "string", "minLength": 1 },
        "native_build_number": { "type": "integer", "minimum": 11 },
        "runtime_asset_count": { "type": "integer", "minimum": 1 },
        "runtime_assets_verified": { "const": true },
        "capacitor_generated_assets_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cordova.js", "cordova_plugins.js"],
          "properties": {
            "cordova.js": { "$ref": "#/$defs/sha256" },
            "cordova_plugins.js": { "$ref": "#/$defs/sha256" }
          }
        },
        "build_json_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_asset_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "build_identity_js_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "commit_exact", "ref"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "commit_exact": { "const": true },
        "ref": { "const": "refs/heads/main" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workflow",
        "number",
        "highest_fleet_version_code",
        "minimum_next_version_code"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
        "workflow": { "const": "custodial-android" },
        "number": { "type": "integer", "minimum": 11 },
        "highest_fleet_version_code": { "type": "integer", "minimum": 1 },
        "minimum_next_version_code": { "type": "integer", "minimum": 2 }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_count",
        "signer_sha256",
        "signer_public_key_sha256",
        "verified_schemes",
        "v2_or_newer"
      ],
      "properties": {
        "signer_count": { "const": 1 },
        "signer_sha256": {
          "const": "dd2e0b44abee02b4d9e1be74edaa05587a93f5e4c502716df99639bc96e7a0bf"
        },
        "signer_public_key_sha256": {
          "const": "5bbf30c71444534f189f75cfa3e65779285a4e8e25ff3fd7cbfa1cbc86de1d4c"
        },
        "verified_schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": 2 },
          "contains": { "const": 2 }
        },
        "v2_or_newer": { "const": true }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "page_alignment_bytes", "zip_entry_alignment_bytes"],
      "properties": {
        "verified": { "const": true },
        "page_alignment_bytes": { "const": 16384 },
        "zip_entry_alignment_bytes": { "const": 4 }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_version",
        "policy",
        "allow_backup",
        "excluded_domains",
        "legacy_resource",
        "data_extraction_resource"
      ],
      "properties": {
        "verifier_version": { "const": "2.0.1" },
        "policy": { "const": "deny-cloud-backup-and-device-transfer" },
        "allow_backup": { "const": false },
        "excluded_domains": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "root" },
            { "const": "file" },
            { "const": "database" },
            { "const": "sharedpref" },
            { "const": "external" },
            { "const": "device_root" },
            { "const": "device_file" },
            { "const": "device_database" },
            { "const": "device_sharedpref" }
          ],
          "items": false
        },
        "legacy_resource": {
          "allOf": [
            { "$ref": "#/$defs/compiledBackupResource" },
            {
              "type": "object",
              "properties": { "logical_name": { "const": "xml/memphis_zoo_backup_rules" } }
            }
          ]
        },
        "data_extraction_resource": {
          "allOf": [
            { "$ref": "#/$defs/compiledBackupResource" },
            {
              "type": "object",
              "properties": { "logical_name": { "const": "xml/memphis_zoo_data_extraction_rules" } }
            }
          ]
        }
      }
    },
    "native_security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_package",
        "plugin_class",
        "plugin_registered_exactly_once",
        "native_class_present",
        "old_secure_storage_absent",
        "webview_plaintext_credential_transport_absent",
        "status_only_shell_verified",
        "webview_executable_count",
        "webview_executable_sha256",
        "plugin_manifest_sha256",
        "dex_sha256"
      ],
      "properties": {
        "plugin_package": { "const": "@memphis-zoo/custodial-native-vault" },
        "plugin_class": { "const": "org.memphiszoo.custodial.vault.CustodialNativeVaultPlugin" },
        "plugin_registered_exactly_once": { "const": true },
        "native_class_present": { "const": true },
        "old_secure_storage_absent": { "const": true },
        "webview_plaintext_credential_transport_absent": { "const": true },
        "status_only_shell_verified": { "const": true },
        "webview_executable_count": { "type": "integer", "minimum": 1 },
        "webview_executable_sha256": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^assets/public/.+\\.(?:html|js|mjs)$": { "$ref": "#/$defs/sha256" }
          }
        },
        "plugin_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "dex_sha256": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^classes(?:[0-9]+)?\\.dex$": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "android_build_tools_version",
        "aapt2",
        "apksigner",
        "apksigner_jar",
        "source_properties",
        "zipalign",
        "unzip",
        "node"
      ],
      "properties": {
        "android_build_tools_version": { "const": "35.0.1" },
        "aapt2": { "$ref": "#/$defs/tool" },
        "apksigner": { "$ref": "#/$defs/tool" },
        "apksigner_jar": { "$ref": "#/$defs/tool" },
        "source_properties": { "$ref": "#/$defs/tool" },
        "zipalign": { "$ref": "#/$defs/tool" },
        "unzip": { "$ref": "#/$defs/tool" },
        "node": {
          "allOf": [
            { "$ref": "#/$defs/tool" },
            {
              "type": "object",
              "properties": { "version": { "const": "v22.23.1" } }
            }
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_acceptance_version",
        "release_acceptance_source_sha256",
        "backup_verifier_version",
        "backup_verifier_source_sha256",
        "acceptance_schema_sha256",
        "release_policy_sha256",
        "toolchain_policy_sha256"
      ],
      "properties": {
        "release_acceptance_version": { "const": "3.0.1" },
        "release_acceptance_source_sha256": { "$ref": "#/$defs/sha256" },
        "backup_verifier_version": { "const": "2.0.1" },
        "backup_verifier_source_sha256": { "$ref": "#/$defs/sha256" },
        "acceptance_schema_sha256": { "$ref": "#/$defs/sha256" },
        "release_policy_sha256": { "$ref": "#/$defs/sha256" },
        "toolchain_policy_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compiledBackupResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "logical_name", "packaged_path", "semantic_sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "logical_name": { "type": "string", "pattern": "^xml/[a-z0-9_]+$" },
        "packaged_path": { "type": "string", "pattern": "^res/(?:[^/]+/)*[^/]+\\.xml$" },
        "semantic_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
