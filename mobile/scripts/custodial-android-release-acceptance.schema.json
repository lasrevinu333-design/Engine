      "const": "urn:memphis-zoo:custodial-android-release-acceptance:v5"
    },
    "schema_version": {
      "const": 5
    },
    "accepted": {
      "const": true
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "apk_sha256",
        "size_bytes"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "apk_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_code",
        "version_name",
        "min_sdk_version",
        "target_sdk_version",
        "debuggable",
        "test_only"
      ],
      "properties": {
        "package_name": {
          "const": "org.memphiszoo.custodial"
        },
        "version_code": {
          "type": "integer",
          "minimum": 11
        },
        "version_name": {
          "const": "1.0.0"
        },
        "min_sdk_version": {
          "const": 26
        },
        "target_sdk_version": {
          "const": 36
        },
        "debuggable": {
          "const": false
        },
        "test_only": {
          "const": false
        }
      }
    },
    "embedded_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "source_commit",
        "source_tree",
        "source_commit_exact",
        "custodial_native_vault_source_sha256",
        "release_id",
        "build_id",
        "native_build_number",
        "runtime_asset_count",
        "runtime_assets_verified",
        "capacitor_generated_assets_sha256",
        "build_json_sha256",
        "runtime_asset_manifest_sha256",
        "build_identity_js_sha256"
      ],
      "properties": {
        "edition": {
          "const": "custodial"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "source_commit_exact": {
          "const": true
        },
        "custodial_native_vault_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "native_build_number": {
          "type": "integer",
          "minimum": 11
        },
        "runtime_asset_count": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_assets_verified": {
          "const": true
        },
        "capacitor_generated_assets_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cordova.js",
            "cordova_plugins.js"
          ],
          "properties": {
            "cordova.js": {
              "$ref": "#/$defs/sha256"
            },
            "cordova_plugins.js": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "build_json_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_asset_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_identity_js_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "commit_exact",
        "ref"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "commit_exact": {
          "const": true
        },
        "ref": {
          "const": "refs/heads/main"
