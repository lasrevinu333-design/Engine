    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workflow",
        "number",
        "highest_fleet_version_code",
        "minimum_next_version_code"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
