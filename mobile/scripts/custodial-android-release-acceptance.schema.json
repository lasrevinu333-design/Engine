      "properties": {
        "signer_count": {
          "const": 1
        },
        "signer_sha256": {
          "const": "dd2e0b44abee02b4d9e1be74edaa05587a93f5e4c502716df99639bc96e7a0bf"
        },
        "signer_public_key_sha256": {
          "const": "5bbf30c71444534f189f75cfa3e65779285a4e8e25ff3fd7cbfa1cbc86de1d4c"
        },
        "verified_schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 2
          },
          "contains": {
            "const": 2
          }
        },
        "v2_or_newer": {
          "const": true
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
