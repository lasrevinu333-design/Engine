              "$ref": "#/$defs/tool"
            },
            {
              "type": "object",
              "properties": {
                "version": {
                  "const": "v22.23.1"
                }
              }
            }
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_acceptance_version",
        "release_acceptance_source_sha256",
        "backup_verifier_version",
        "backup_verifier_source_sha256",
        "capacitor_runtime_policy_version",
        "capacitor_runtime_policy_source_sha256",
        "android_manifest_security_verifier_version",
        "android_manifest_security_verifier_source_sha256",
        "dex_semantic_verifier_version",
        "dex_semantic_verifier_source_sha256",
        "acceptance_schema_sha256",
        "release_policy_sha256",
        "toolchain_policy_sha256"
      ],
      "properties": {
        "release_acceptance_version": {
          "const": "5.0.1"
        },
        "release_acceptance_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backup_verifier_version": {
          "const": "2.0.1"
        },
        "backup_verifier_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capacitor_runtime_policy_version": {
          "const": "1.1.0"
        },
        "capacitor_runtime_policy_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "android_manifest_security_verifier_version": {
          "const": "1.1.0"
        },
        "android_manifest_security_verifier_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dex_semantic_verifier_version": {
          "const": "1.0.0"
        },
        "dex_semantic_verifier_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "acceptance_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dexName": {
      "type": "string",
      "pattern": "^classes(?:[0-9]+)?\\.dex$"
    },
    "compiledBackupResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_name",
        "packaged_path",
        "semantic_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "logical_name": {
          "type": "string",
          "pattern": "^xml/[a-z0-9_]+$"
        },
        "packaged_path": {
          "type": "string",
          "pattern": "^res/(?:[^/]+/)*[^/]+\\.xml$"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
