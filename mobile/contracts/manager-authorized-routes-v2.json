{
  "contract_version": "manager-authorized-routes.v2",
  "access_level": "full_access",
  "routes": [
    { "method": "GET", "path_expression": "/admin-api/(?:health|device-auth/summary|device-security/session)", "example": "/admin-api/device-auth/summary" },
    { "method": "POST", "path_expression": "/admin-api/(?:attendance-update|bundle|close-ticket|force-close-session|device-auth/enrollment-code|device-auth/mode|device-security/lock|device-security/unlock|device-security/sessions/revoke-all)", "example": "/admin-api/device-auth/enrollment-code" },
    { "method": "POST", "path_expression": "/admin-api/device-auth/(?:codes|credentials)/[A-Za-z0-9._~-]+/revoke", "example": "/admin-api/device-auth/codes/code-1/revoke" },
    { "method": "GET", "path_expression": "/admin-api/events(?:/(?:location-groups|event-venues|coverage-locations))?", "example": "/admin-api/events/location-groups" },
    { "method": "POST", "path_expression": "/admin-api/events(?:/parse-ai)?", "example": "/admin-api/events/parse-ai" },
    { "method": "PUT", "path_expression": "/admin-api/events/[A-Za-z0-9._~-]+", "example": "/admin-api/events/event-1" },
    { "method": "DELETE", "path_expression": "/admin-api/events/[A-Za-z0-9._~-]+", "example": "/admin-api/events/event-1" },
    { "method": "GET", "path_expression": "/auth-api/ops/trusted-devices", "example": "/auth-api/ops/trusted-devices" },
    { "method": "PATCH", "path_expression": "/auth-api/ops/trusted-devices/[A-Za-z0-9._~-]+", "example": "/auth-api/ops/trusted-devices/credential-1" },
    { "method": "POST", "path_expression": "/auth-api/ops/trusted-devices/(?:revoke-all|[A-Za-z0-9._~-]+/(?:rename|revoke))", "example": "/auth-api/ops/trusted-devices/credential-1/revoke" },
    { "method": "GET", "path_expression": "/dashboard-api/(?:canary|current-attendance|events|guest-cleanliness-issues|health|summary|system-feedback|work-session-alerts)", "example": "/dashboard-api/summary" },
    { "method": "POST", "path_expression": "/dashboard-api/(?:close-ticket|guest-cleanliness-issues/[A-Za-z0-9._~-]+/resolve|system-feedback/[A-Za-z0-9._~-]+/status)", "example": "/dashboard-api/guest-cleanliness-issues/report-1/resolve" },
    { "method": "GET", "path_expression": "/feedback-api/(?:health|acknowledge/[A-Za-z0-9._~-]+|image/[A-Za-z0-9._~-]+)", "example": "/feedback-api/image/report-1" },
    { "method": "POST", "path_expression": "/feedback-api/(?:acknowledge/[A-Za-z0-9._~-]+|reminders/run|submit)", "example": "/feedback-api/submit" },
    { "method": "GET", "path_expression": "/leadership-api/(?:health|phone-assignments|roster)", "example": "/leadership-api/phone-assignments" },
    { "method": "POST", "path_expression": "/leadership-api/(?:managers/[A-Za-z0-9._~-]+/enrollment-code|phone-assignments/[A-Za-z0-9._~-]+(?:/enrollment-code)?)", "example": "/leadership-api/managers/manager-1/enrollment-code" },
    { "method": "GET", "path_expression": "/manager-notifications-api/(?:health|preferences|client-config/[A-Za-z0-9._~-]+)", "example": "/manager-notifications-api/preferences" },
    { "method": "POST", "path_expression": "/manager-notifications-api/(?:register|test)", "example": "/manager-notifications-api/register" },
    { "method": "PUT", "path_expression": "/manager-notifications-api/preferences", "example": "/manager-notifications-api/preferences" },
    { "method": "DELETE", "path_expression": "/manager-notifications-api/register", "example": "/manager-notifications-api/register" },
    { "method": "GET", "path_expression": "/analytics-api/(?:cleaning-performance|inspection-coverage|inspections|session-facts|ticket-trends)", "example": "/analytics-api/inspection-coverage" },
    { "method": "POST", "path_expression": "/analytics-api/inspections", "example": "/analytics-api/inspections" },
    { "method": "GET", "path_expression": "/messaging-api/(?:health|me/by-device|users|threads|threads/updates|device-event-reminders|device-location-status-reminders|thread/[A-Za-z0-9._~-]+/(?:updates|messages))", "example": "/messaging-api/thread/thread-1/messages" },
    { "method": "POST", "path_expression": "/messaging-api/(?:device-notifications/ack|thread/(?:direct|group|team)|thread/[A-Za-z0-9._~-]+/(?:message|delete|admin-tombstone|read)|thread/[A-Za-z0-9._~-]+/message/[A-Za-z0-9._~-]+/delete|memphis/(?:thread|diagnose|message)|broadcast)", "example": "/messaging-api/thread/thread-1/message" },
    { "method": "GET", "path_expression": "/moxie-mobile-api/workspace", "example": "/moxie-mobile-api/workspace" },
    { "method": "POST", "path_expression": "/moxie-mobile-api/chat", "example": "/moxie-mobile-api/chat" },
    { "method": "PUT", "path_expression": "/moxie-mobile-api/chat-state", "example": "/moxie-mobile-api/chat-state" },
    { "method": "POST", "path_expression": "/moxie-mobile-api/(?:notes|reminders|contacts)", "example": "/moxie-mobile-api/notes" },
    { "method": "DELETE", "path_expression": "/moxie-mobile-api/(?:notes|reminders|contacts)/[A-Za-z0-9._~-]+", "example": "/moxie-mobile-api/notes/note-1" },
    { "method": "GET", "path_expression": "/scan-api/health", "example": "/scan-api/health" },
    { "method": "POST", "path_expression": "/scan-api/rpc", "example": "/scan-api/rpc" },
    { "method": "GET", "path_expression": "/events-api(?:/(?:health|location-groups|event-venues|coverage-locations))?", "example": "/events-api/event-venues" },
    { "method": "POST", "path_expression": "/events-api(?:/parse-ai)?", "example": "/events-api/parse-ai" },
    { "method": "PUT", "path_expression": "/events-api/[A-Za-z0-9._~-]+", "example": "/events-api/event-1" },
    { "method": "DELETE", "path_expression": "/events-api/[A-Za-z0-9._~-]+", "example": "/events-api/event-1" },
    { "method": "GET", "path_expression": "/gemini-api/(?:health|conversations|search|attachments/[A-Za-z0-9._~-]+|conversations/[A-Za-z0-9._~-]+/(?:messages|repair-state))", "example": "/gemini-api/conversations/conversation-1/messages" },
    { "method": "POST", "path_expression": "/gemini-api/(?:conversations|conversations/[A-Za-z0-9._~-]+/(?:attachments|messages/stream)|messages/[A-Za-z0-9._~-]+/cancel)", "example": "/gemini-api/conversations/conversation-1/messages/stream" },
    { "method": "PATCH", "path_expression": "/gemini-api/conversations/[A-Za-z0-9._~-]+", "example": "/gemini-api/conversations/conversation-1" },
    { "method": "DELETE", "path_expression": "/gemini-api/(?:conversations|attachments)/[A-Za-z0-9._~-]+", "example": "/gemini-api/attachments/attachment-1" },
    { "method": "GET", "path_expression": "/schedule-api/(?:health|audit/day|work-status|today|day|my-day|my-day-summary|my-schedule|settings/close-time|employees|employee-aliases|shift-templates|pto|coverall/slots|coverall/assignment|location-groups|audit|coverage-templates/export[.]csv|locations/workload-settings|current-owner|sch2/runs|sch2/explain|generation-window|restroom-rebalance/status)", "example": "/schedule-api/my-day-summary" },
    { "method": "POST", "path_expression": "/schedule-api/(?:settings/close-time|employee-aliases|pto/(?:import|import-report|parse-report)|coverall/(?:slots|links|links/revoke)|ai/(?:recommendations|audit)|locations/[A-Za-z0-9._~-]+/workload-settings|generate-daily|sch2/(?:preview|publish|rollback)|generate-range|manual-absences/(?:publish|return)|absence-(?:preview|publish)|restroom-rebalance/run)", "example": "/schedule-api/manual-absences/publish" },
    { "method": "PATCH", "path_expression": "/schedule-api/(?:employee-aliases/[A-Za-z0-9._~-]+|shift-templates/metadata)", "example": "/schedule-api/shift-templates/metadata" }
  ]
}
