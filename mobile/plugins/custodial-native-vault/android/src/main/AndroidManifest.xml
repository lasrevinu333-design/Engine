<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal app declarations only; exact build verifier admits no broader
         type/exported owner. Runtime still requires qualified release inputs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <!-- Explicit operator-only foreground preparation; no BROWSABLE,
             launcher, startup, employee bridge or newly granted permission. -->
        <activity
            android:name="org.memphiszoo.custodial.vault.NativeProtectedRecoveryPreparationActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="org.memphiszoo.custodial.ORIGINAL_RECOVERY_PREPARATION" />
            </intent-filter>
        </activity>
        <service
            android:name="org.memphiszoo.custodial.vault.CustodialProviderAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="org.memphiszoo.custodial.vault.CustodialProviderSyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name="org.memphiszoo.custodial.vault.ProviderNotificationOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <receiver
            android:name="org.memphiszoo.custodial.vault.ProviderNotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name="org.memphiszoo.custodial.vault.AssignedDeviceActivationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.memphiszoo.custodial.ACTIVATE_ASSIGNED_DEVICE" />
                <action android:name="org.memphiszoo.custodial.ASSIGNED_ACTIVATION_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
