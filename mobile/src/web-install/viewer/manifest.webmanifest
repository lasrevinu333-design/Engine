{
  "name": "Memphis Zoo Custodial Viewer",
  "short_name": "Zoo Viewer",
  "description": "Read-only Custodial dashboard and event information",
  "id": "/viewer/",
  "start_url": "/viewer/",
  "scope": "/viewer/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4E6D7",
  "theme_color": "#A45434",
  "icons": [
    { "src": "/viewer/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/viewer/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/viewer/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
