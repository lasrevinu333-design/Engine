      "required_suites": ["source-contracts", "scan-browser", "mobile-contracts", "android-builds", "backend-contracts", "backend-disposable-db", "property-model", "mutation", "api-fuzz", "performance-api", "firebase-device-lab", "combinatorial-matrix", "manual-field"],
      "invariants": ["single-open-session", "start-finish-order", "offline-pending-not-complete", "idempotent-replay", "gps-evidence-honest", "nfc-opens-correct-location", "cancel-reconciles"]
