{
  "schema_version": 1,
  "name": "Memphis Zoo Operations whole-system change-impact map",
  "production_file_extensions": [".html", ".js", ".mjs", ".css", ".ts", ".tsx", ".json", ".xml", ".gradle", ".kts"],
  "ignored_path_prefixes": ["docs/", "tests/", "scripts/", "tools/", "quality/", ".github/"],
  "suites": {
    "source-contracts": { "status": "implemented", "cadence": "every-change" },
    "auth-browser": { "status": "implemented", "cadence": "every-change" },
    "gemini-browser": { "status": "implemented", "cadence": "every-change" },
    "messaging-browser": { "status": "implemented", "cadence": "every-change" },
    "scan-browser": { "status": "implemented", "cadence": "every-change" },
    "events-browser": { "status": "implemented", "cadence": "every-change" },
    "unity-browser": { "status": "implemented", "cadence": "every-change" },
    "mobile-contracts": { "status": "implemented", "cadence": "every-change" },
    "android-builds": { "status": "implemented", "cadence": "every-change" },
    "backend-contracts": { "status": "implemented", "cadence": "every-backend-change" },
    "backend-disposable-db": { "status": "implemented", "cadence": "every-backend-change" },
    "render-live": { "status": "implemented", "cadence": "after-backend-deploy" },
    "supabase-pgtap": { "status": "planned", "cadence": "every-schema-change" },
    "visual-regression": { "status": "planned", "cadence": "every-ui-change" },
    "accessibility-web": { "status": "planned", "cadence": "every-ui-change" },
    "accessibility-android": { "status": "planned", "cadence": "nightly-and-release" },
    "property-model": { "status": "planned", "cadence": "every-domain-change" },
    "mutation": { "status": "planned", "cadence": "nightly" },
    "consumer-contract": { "status": "planned", "cadence": "every-api-change" },
    "api-fuzz": { "status": "planned", "cadence": "nightly" },
    "security-static": { "status": "planned", "cadence": "every-change" },
    "security-dynamic": { "status": "planned", "cadence": "nightly-and-release" },
    "performance-web": { "status": "planned", "cadence": "nightly-and-release" },
    "performance-api": { "status": "planned", "cadence": "nightly-and-release" },
    "performance-android": { "status": "planned", "cadence": "release" },
    "firebase-device-lab": { "status": "planned", "cadence": "nightly-and-release" },
    "combinatorial-matrix": { "status": "planned", "cadence": "nightly" },
    "manual-field": { "status": "required", "cadence": "release" },
    "recovery-drill": { "status": "required", "cadence": "quarterly" }
  },
  "global_invariants": [
    "No operation may silently claim success before authoritative persistence is confirmed.",
    "A retry must not duplicate a scan, cleaning completion, message, employee, phone assignment, event, notification acknowledgement, or feedback item.",
    "Historical work remains attributed to the employee who performed it after a phone is reassigned.",
    "Changing a phone assignment changes future identity without deleting device credentials or historical records.",
    "A NOT CLEANED dashboard row shows only location and status; in-progress and completed rows show all available operational data.",
    "The canonical Back control is the same size, shape, label, and upper-left placement on every app page.",
    "Android system navigation, display cutouts, keyboard, and app navigation never cover interactive content.",
    "Manager authority, employee device authority, and viewer authority never cross boundaries.",
    "The retired Operations Leadership room never reappears in active thread lists.",
    "Release ID, frontend asset hashes, backend commit, schema fingerprint, and API contracts identify one coordinated release.",
    "Offline work is durable, visibly pending, replay-safe, and reconcilable with server authority.",
    "All timestamps use an explicit operational timezone and survive daylight-saving transitions.",
    "Every destructive action is authenticated, authorized, confirmed, auditable, and recoverable where policy permits.",
    "No production secret, privileged session token, device credential, or one-time code is written to logs or ordinary browser storage.",
    "A failed dependency degrades one capability without corrupting unrelated operational state."
  ],
  "components": [
    {
      "id": "shared-design-navigation",
      "risk": "high",
      "patterns": ["memphis-ui.css", "memphis-ui.js", "memphis-theme.css", "manager-ux.css", "ops-hub.css", "employee-hub.html", "mobile/src/shared/**", "chatscope-mobile-overrides.css", "chatscope-messenger.js", "mobile.css", "field-guide.css"],
      "depends_on": [],
      "required_suites": ["source-contracts", "unity-browser", "visual-regression", "accessibility-web", "mobile-contracts", "android-builds", "firebase-device-lab", "manual-field"],
      "invariants": ["canonical-back-control", "safe-area-clearance", "touch-targets", "focus-visibility", "reduced-motion", "no-horizontal-overflow"]
    },
    {
      "id": "manager-auth-authority",
      "risk": "critical",
      "patterns": ["memphis-auth.js", "ops-manager-hub.html", "manager-access.html", "device-security.html", "mobile/src/shared/mobile-bridge.js", "mobile/src/manager/manager-access*"],
      "depends_on": ["release-coordination"],
      "required_suites": ["source-contracts", "auth-browser", "backend-contracts", "render-live", "security-static", "security-dynamic", "manual-field"],
      "invariants": ["named-manager-only", "no-token-persistence", "role-separation", "session-expiry", "revocation-immediate"]
    },
    {
      "id": "device-identity-credentials",
