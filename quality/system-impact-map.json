      "required_suites": ["source-contracts", "unity-browser", "visual-regression", "accessibility-web", "performance-web", "combinatorial-matrix", "manual-field"],
      "invariants": ["not-cleaned-compact", "status-color-and-text", "freshness-visible", "open-ticket-count-consistent", "no-covered-footer", "sort-priority-stable"]
