      "external_patterns": ["backend:src/*notification*", "backend:supabase/migrations/*notification*"],
      "depends_on": ["notifications", "mobile-packaging", "backend-api"],
      "required_suites": ["mobile-contracts", "android-builds", "backend-contracts", "firebase-device-lab", "manual-field"],
      "invariants": ["project-package-match", "token-refresh", "foreground-and-background-delivery", "duplicate-suppression", "revoked-device-stops-receiving"]
