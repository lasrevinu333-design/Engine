      "depends_on": ["manager-auth-authority", "employee-phone-lifecycle"],
      "required_suites": ["source-contracts", "auth-browser", "scan-browser", "mobile-contracts", "android-builds", "backend-contracts", "backend-disposable-db", "render-live", "property-model", "firebase-device-lab", "manual-field"],
      "invariants": ["canonical-device-precedence", "credential-preserved-on-reassignment", "alias-consistency", "invalid-origin-rejected", "secure-storage-first"]
    },
    {
      "id": "employee-phone-lifecycle",
      "risk": "critical",
      "patterns": ["phone-assignments.html", "phone-assignments.js", "phone-assignments.css", "mobile/src/custodial/**"],
      "depends_on": ["manager-auth-authority", "messenger", "schedule", "device-identity-credentials"],
      "required_suites": ["source-contracts", "auth-browser", "mobile-contracts", "android-builds", "backend-contracts", "backend-disposable-db", "property-model", "combinatorial-matrix", "manual-field"],
      "invariants": ["history-stays-with-worker", "new-identity-on-wake", "inactive-worker-releases-phone", "no-reinstall-required", "one-active-worker-per-phone", "one-active-phone-per-worker"]
    },
    {
