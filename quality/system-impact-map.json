      "required_suites": ["source-contracts", "messaging-browser", "unity-browser", "mobile-contracts", "android-builds", "backend-contracts", "consumer-contract", "api-fuzz", "property-model", "mutation", "visual-regression", "accessibility-web", "firebase-device-lab", "manual-field"],
      "invariants": ["one-messenger-client", "memphis-ai-pinned", "retired-room-hidden", "idempotent-send", "durable-outbox", "correct-user-attribution", "read-only-enforced", "delete-authoritative"]
