            "        if (\"audio_started\".equals(action)) claim.audioStarted = true;"
          ],
          "after": [
            "        if (\"audio_started\".equals(action)) {",
            "            if (!journal.tryStartAudio(current, claim.presentation, observation)) {",
            "                claim.audioCompleted = true; // Retire unused local offer, not the other owner's durable audio.",
            "                throw new VaultFailure(\"custodial_provider_audio_already_owned\");",
            "            }",
            "            claim.audioStarted = true;",
            "        } else journal.applyPresentationAction(current, claim.presentation, action, observation);"
          ]
        }
