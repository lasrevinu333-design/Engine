            "      const held=new Set(originals.map(item=>item.ticket_id));",
            "      els.ticketsWrap.querySelectorAll(\".closeBtn\").forEach(btn=>{",
            "        if(held.has(String(btn.dataset.ticketId).toLowerCase())){btn.disabled=true;btn.textContent='Check original closure';}",
